# Helper functions

def mean_std(values):
    """
    Calculate mean and sample standard deviation,
    ignoring NaN values.
    """
    values = np.asarray(values, dtype=float)
    values = values[np.isfinite(values)]

    if len(values) == 0:
        return np.nan, np.nan

    mean = np.mean(values)

    if len(values) > 1:
        std = np.std(values, ddof=DDOF)
    else:
        std = np.nan

    return mean, std


def format_mean_std(values, decimals=4):
    """
    Format a list of values as:

        0.9535 $\\pm$ 0.0041
    """

    mean, std = mean_std(values)

    if np.isnan(mean):
        return "--"

    if np.isnan(std):
        return f"{mean:.{decimals}f} $\\pm$ --"

    return (
        f"{mean:.{decimals}f} "
        f"$\\pm$ "
        f"{std:.{decimals}f}"
    )

# Model extraction

def get_model_name(experiment_name):
    """
    Extract one of the requested model names from an experiment name.

    RN examples
    -----------
    ONTO_BASE_extremes_run0
        -> ONTO_BASE

    ONTO_32_extremes_run0
        -> ONTO_32


    HN examples
    -----------
    C2_L128_ONTO_BASE_extremes_preRN_run0
        -> ONTO_BASE

    C2_L128_ONTO_32_extremes_preRN_run0
        -> ONTO_32

    The function specifically looks for one of the requested model
    names as a component of the experiment name.
    """

    # Longest first so ONTO_BASE_SKIP is checked before ONTO_BASE.
    models_sorted = sorted(
        MODELS,
        key=len,
        reverse=True,
    )

    for model in models_sorted:

        # Model must occur as an underscore-delimited component.
        pattern = rf"(?:^|_){re.escape(model)}(?:_|$)"

        if re.search(pattern, experiment_name):
            return model

    return None

# Determine file type

def is_hn_file(result_type):
    """
    Return True for the HN result files.

    HN files contain the intermediate metrics in:
        rn_ontology_val

    RN files contain them in:
        train
    """

    return result_type in {
        "Original HN",
        "Integrated HN",
    }


# Extract intermediate metrics from one run

def extract_run_intermediate_values(
    experiment_name,
    experiment_data,
    result_type,
):
    """
    Extract all intermediate balanced accuracies for one run.

    RN format:
        train
            A13_balanced_accuracy
            A14_balanced_accuracy
            ...

    HN format:
        rn_ontology_val
            balanced_accuracy_A13
            balanced_accuracy_A14
            ...
    """

    if is_hn_file(result_type):

        # HN format
        if "rn_ontology_val" not in experiment_data:
            print(
                f"WARNING: {experiment_name} has no "
                f"'rn_ontology_val' section."
            )
            return []

        metrics = experiment_data["rn_ontology_val"]

        metric_values = []
        missing_metrics = []

        for category in INTERMEDIATE_CATEGORIES:

            metric_name = f"balanced_accuracy_{category}"

            if metric_name not in metrics:
                missing_metrics.append(metric_name)
                continue

            value = metrics[metric_name]

            try:
                value = float(value)

                if np.isfinite(value):
                    metric_values.append(value)
                else:
                    missing_metrics.append(metric_name)

            except (TypeError, ValueError):
                missing_metrics.append(metric_name)

    else:

        # RN format
        if "train" not in experiment_data:
            print(
                f"WARNING: {experiment_name} has no "
                f"'train' section."
            )
            return []

        metrics = experiment_data["train"]

        metric_values = []
        missing_metrics = []

        for category in INTERMEDIATE_CATEGORIES:

            metric_name = f"{category}_balanced_accuracy"

            if metric_name not in metrics:
                missing_metrics.append(metric_name)
                continue

            value = metrics[metric_name]

            try:
                value = float(value)

                if np.isfinite(value):
                    metric_values.append(value)
                else:
                    missing_metrics.append(metric_name)

            except (TypeError, ValueError):
                missing_metrics.append(metric_name)

    # Warnings

    if missing_metrics:
        print(
            f"WARNING: {experiment_name} "
            f"({result_type}) is missing "
            f"{len(missing_metrics)} intermediate metric(s)."
        )

        print(
            "         Missing: "
            + ", ".join(missing_metrics)
        )

    return metric_values

# Process one results.json

def process_results_file(json_file, result_type):
    """
    Process one results.json.

    Returns
    -------
    dict
        {
            "ONTO_BASE": [run_average_1, run_average_2, ...],
            "ONTO_32": [...],
            ...
        }

    Each value in the lists is the average of all intermediate
    classifications for ONE run.
    """

    if not json_file.exists():
        raise FileNotFoundError(
            f"Results file not found: {json_file}"
        )

    with open(json_file, "r") as f:
        data = json.load(f)

    experiments = data.get("experiments", {})

    # Group experiments by model

    grouped = {
        model: []
        for model in MODELS
    }

    for experiment_name, experiment_data in experiments.items():

        model_name = get_model_name(experiment_name)

        # Ignore all models we are not interested in.
        if model_name is None:
            continue

        grouped[model_name].append(
            {
                "name": experiment_name,
                "data": experiment_data,
            }
        )

    # Calculate one average per run

    results = {}

    for model_name in MODELS:

        run_averages = []

        for run in grouped[model_name]:

            experiment_name = run["name"]
            experiment_data = run["data"]

            metric_values = extract_run_intermediate_values(
                experiment_name,
                experiment_data,
                result_type,
            )

            if len(metric_values) == 0:
                print(
                    f"WARNING: {experiment_name} has no valid "
                    f"intermediate balanced accuracies."
                )
                continue

            # Average all intermediate classifications for
            # THIS RUN.

            run_average = np.mean(metric_values)

            run_averages.append(run_average)

        results[model_name] = run_averages

    return results


