        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.semanticweb.org/manerix/ontologies/2020/9/Traffic_Signals_Ontology#hasBorder"/>
                                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/manerix/ontologies/2020/9/Traffic_Signals_Ontology#Red"/>
                                    </owl:Restriction>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.semanticweb.org/manerix/ontologies/2020/9/Traffic_Signals_Ontology#hasGround"/>
                                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/manerix/ontologies/2020/9/Traffic_Signals_Ontology#Blue"/>
                                    </owl:Restriction>
